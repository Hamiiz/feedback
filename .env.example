# ─── Bot ──────────────────────────────────────────────────────────────────────
BOT_TOKEN=your_telegram_bot_token_here

# ─── Admin ────────────────────────────────────────────────────────────────────
# The chat ID or channel ID where all feedback notifications will be forwarded.
# For a group: a negative number like -1001234567890
# For a private channel: also negative, e.g. -1009876543210
ADMIN_CHAT_ID=your_admin_chat_id_here

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:password@localhost:5432/feedbackbot

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Webhooks (production only) ───────────────────────────────────────────────
# Public HTTPS URL that Telegram will POST updates to.
# Leave empty in development — the bot will use long polling instead.
# Example: https://yourdomain.com
WEBHOOK_DOMAIN=

# A random secret string to validate Telegram webhook requests.
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=your_random_webhook_secret_here

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# Max number of messages a user can send within the window.
RATE_LIMIT_MAX=3
# Window duration in seconds.
RATE_LIMIT_WINDOW_SECONDS=30
