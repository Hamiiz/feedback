// Prisma schema for the Telegram Feedback Bot
// Run: npx prisma migrate dev

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id          Int      @id @default(autoincrement())
  telegramId  BigInt   @unique
  username    String?
  firstName   String
  lastName    String?

  // Anonymous mode: when true, admin sees alias instead of real profile
  isAnonymous Boolean  @default(false)

  // Moderation
  isBanned    Boolean  @default(false)
  banReason   String?
  bannedAt    DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("users")
}

// Admin-managed feedback categories.
// When the table is empty, the category picker is hidden and all
// submissions go straight through without a picker.
model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("categories")
}

// Lightweight reply-routing map.
// Written once per submission (after forwarding to the admin chat).
// Read once when an admin replies. No feedback content is stored here.
model ReplyMap {
  adminMessageId BigInt   @id        // message_id of the forwarded notification
  userTelegramId BigInt               // original sender's Telegram ID
  senderName     String               // first name, used in delivery confirmation
  createdAt      DateTime @default(now())

  @@map("reply_map")
}

// Telegraf session store — keyed by "chatId:userId" string
model BotSession {
  id        String   @id
  data      Json
  updatedAt DateTime @updatedAt

  @@map("bot_sessions")
}
